{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chess Trainer",
  "version": "0.1.0",
  "identifier": "com.yansiqi.chesstrainer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chess Trainer",
        "width": 1320,
        "height": 850,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": ["app"] }
}
