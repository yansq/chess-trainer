{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chess Trainer",
  "version": "0.2.0",
  "identifier": "com.yansiqi.chesstrainer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chess Trainer",
        "width": 1320,
        "height": 850,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0OTIzQ0ZBNUY5NkE4RDkKUldUWnFKWmYranlTSkZ5bWpibkxvZGxvZ1kvTUYrN3ZxL2ZQZFQ4WS8vVnN6bWhaUldNbUltVXQK",
      "endpoints": [
        "https://github.com/yansq/chess-trainer/releases/latest/download/latest.json"
      ]
    }
  }
}
